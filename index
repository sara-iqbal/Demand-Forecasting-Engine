<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Demand Forecasting Engine — Sara Iqbal</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Outfit:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--cream:#faf9f7;--white:#fff;--warm1:#f5f3ef;--border:#e2ddd6;--ink:#1c1a17;--navy:#12234a;--gold:#9a6b00;--gold2:#c4a030;--teal:#0c5f5a;--green:#145232;--red:#8b2020;--amber:#7a4a0a;--muted:#6b6459;--light:#a09890;--display:"Cormorant Garamond",serif;--body:"Outfit",sans-serif;--mono:"JetBrains Mono",monospace;--sh:0 1px 3px rgba(28,26,23,.06),0 4px 16px rgba(28,26,23,.04);}
*{margin:0;padding:0;box-sizing:border-box;}body{background:var(--cream);color:var(--ink);font-family:var(--body);font-size:14px;}
header{background:var(--navy);position:relative;overflow:hidden;}
header::after{content:"";position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--gold),var(--gold2),var(--gold));}
.hgrid{position:absolute;inset:0;opacity:.03;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,#fff 39px,#fff 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,#fff 39px,#fff 40px);}
.hinner{max-width:1340px;margin:0 auto;padding:36px 44px 32px;display:grid;grid-template-columns:1fr auto;gap:32px;align-items:center;position:relative;z-index:1;}
.eyebrow{font-family:var(--mono);font-size:9px;color:rgba(255,255,255,.4);letter-spacing:3px;text-transform:uppercase;margin-bottom:10px;display:flex;align-items:center;gap:12px;}
.eyebrow::before{content:"";width:24px;height:1px;background:var(--gold);}
h1{font-family:var(--display);font-size:clamp(22px,2.8vw,34px);font-weight:600;color:#fff;line-height:1.15;margin-bottom:6px;}
.hsub{font-size:12.5px;color:rgba(255,255,255,.45);line-height:1.9;}
.hstats{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;border:1px solid rgba(255,255,255,.1);border-radius:9px;overflow:hidden;background:rgba(255,255,255,.08);min-width:280px;}
.hs{background:rgba(255,255,255,.03);padding:16px 18px;text-align:center;}
.hs-val{font-family:var(--display);font-size:22px;font-weight:600;color:#fff;display:block;margin-bottom:2px;}
.hs-lbl{font-family:var(--mono);font-size:8px;color:rgba(255,255,255,.35);letter-spacing:1.5px;text-transform:uppercase;}
nav{background:var(--white);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:100;}
.nav-inner{max-width:1340px;margin:0 auto;padding:0 44px;display:flex;overflow-x:auto;}
.ntab{font-size:12px;font-weight:500;color:var(--muted);padding:14px 20px;border:none;background:none;cursor:pointer;border-bottom:2px solid transparent;transition:all .2s;white-space:nowrap;}
.ntab:hover{color:var(--ink);}.ntab.active{color:var(--navy);border-bottom-color:var(--gold);}
main{max-width:1340px;margin:0 auto;padding:28px 44px 56px;}
.sec{display:none;}.sec.active{display:block;}
.kgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(148px,1fr));gap:12px;margin-bottom:22px;}
.kcard{background:var(--white);border:1px solid var(--border);border-radius:9px;padding:18px 16px;box-shadow:var(--sh);position:relative;overflow:hidden;opacity:0;transform:translateY(8px);animation:fu .4s forwards;}
.kcard::before{content:"";position:absolute;top:0;left:0;right:0;height:2.5px;}
.kcard.gld::before{background:linear-gradient(90deg,var(--gold),var(--gold2));}.kcard.nvy::before{background:var(--navy);}.kcard.tel::before{background:var(--teal);}.kcard.grn::before{background:var(--green);}.kcard.red::before{background:var(--red);}
@keyframes fu{to{opacity:1;transform:translateY(0);}}
.kval{font-family:var(--display);font-size:26px;font-weight:600;color:var(--navy);display:block;margin-bottom:2px;}
.klbl{font-family:var(--mono);font-size:8px;color:var(--muted);letter-spacing:1.5px;text-transform:uppercase;}
.ksub{font-size:11px;color:var(--light);margin-top:4px;display:block;}
.pgrid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:18px;}
.panel{background:var(--white);border:1px solid var(--border);border-radius:9px;padding:20px;box-shadow:var(--sh);opacity:0;animation:fu .45s forwards;}
.pfull{grid-column:1/-1;}
.phead{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px;padding-bottom:10px;border-bottom:1px solid var(--border);}
.ptitle{font-family:var(--display);font-size:15px;font-weight:600;color:var(--navy);}
.psub{font-family:var(--mono);font-size:8.5px;color:var(--muted);margin-top:2px;}
.chip{font-family:var(--mono);font-size:8px;padding:3px 9px;border-radius:20px;border:1px solid;text-transform:uppercase;letter-spacing:.8px;}
.chip-nvy{color:var(--navy);border-color:rgba(18,35,74,.2);background:rgba(18,35,74,.04);}
.chip-gld{color:var(--gold);border-color:rgba(154,107,0,.3);background:rgba(154,107,0,.06);}
canvas{max-height:260px;}
table{width:100%;border-collapse:collapse;}
thead tr{border-bottom:2px solid var(--border);}
th{text-align:left;padding:8px 12px;font-family:var(--mono);font-size:8px;color:var(--light);letter-spacing:1.2px;text-transform:uppercase;}
tbody tr{border-bottom:1px solid var(--border);} tbody tr:hover{background:rgba(154,107,0,.03);}
tbody tr:last-child{border-bottom:none;} td{padding:9px 12px;font-size:13px;}
td.mono{font-family:var(--mono);font-size:11px;}
.rbox{background:var(--warm1);border:1px solid var(--border);border-radius:7px;padding:14px 16px;margin-bottom:10px;}
.rbox-title{font-family:var(--mono);font-size:9px;color:var(--muted);letter-spacing:1px;text-transform:uppercase;margin-bottom:5px;}
.rbox-val{font-family:var(--display);font-size:18px;font-weight:600;color:var(--navy);}
.rbox-sub{font-size:11px;color:var(--muted);margin-top:4px;line-height:1.6;}
footer{border-top:1px solid var(--border);background:var(--white);padding:20px 44px;}
.fin{max-width:1340px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;}
.fl{font-size:12.5px;color:var(--muted);line-height:1.7;}.fl strong{color:var(--navy);}
.flinks{display:flex;gap:18px;}.flinks a{font-family:var(--mono);font-size:9.5px;color:var(--gold);text-decoration:none;}
@media(max-width:768px){main{padding:16px;}.pgrid{grid-template-columns:1fr;}.hinner{grid-template-columns:1fr;}}
</style></head><body>
<header><div class="hgrid"></div><div class="hinner">
<div><div class="eyebrow">Time Series Forecasting — Retail & Energy Portfolio Project</div><h1>Demand Forecasting Engine</h1><p class="hsub">ARIMA · Prophet · LSTM · Retail & energy time series · 4 years training data<br>Seasonality decomposition · Holiday effects · 30-day forecast horizon</p></div>
<div class="hstats">
<div class="hs"><span class="hs-val">7.8%</span><span class="hs-lbl">Prophet MAPE</span></div>
<div class="hs"><span class="hs-val">11.2%</span><span class="hs-lbl">LSTM MAPE</span></div>
<div class="hs"><span class="hs-val">30 days</span><span class="hs-lbl">Forecast Horizon</span></div>
</div></div></header>
<nav><div class="nav-inner"><button class="ntab active" onclick="show('overview',this)">Overview</button><button class="ntab" onclick="show('models',this)">Model Comparison</button><button class="ntab" onclick="show('energy',this)">Energy</button></div></nav>
<main><div class="sec active" id="overview">
<div class="kgrid">
<div class="kcard gld" style="animation-delay:.04s"><span class="kval">7.8%</span><span class="klbl">Prophet MAPE</span><span class="ksub">Best model</span></div>
<div class="kcard nvy" style="animation-delay:.08s"><span class="kval">11.2%</span><span class="klbl">LSTM MAPE</span></div>
<div class="kcard tel" style="animation-delay:.12s"><span class="kval">14.6%</span><span class="klbl">ARIMA MAPE</span></div>
<div class="kcard grn" style="animation-delay:.16s"><span class="kval">30 days</span><span class="klbl">Forecast Horizon</span></div>
<div class="kcard nvy" style="animation-delay:.20s"><span class="kval">3</span><span class="klbl">Models Compared</span></div>
<div class="kcard gld" style="animation-delay:.24s"><span class="kval">4 years</span><span class="klbl">Training Data</span></div>
</div>
<div class="pgrid">
<div class="panel pfull"><div class="phead"><div><div class="ptitle">30-Day Forecast — All Models vs Actual</div><div class="psub">ARIMA · Prophet · LSTM · Retail daily demand · Jan-2025</div></div><span class="chip chip-nvy">MULTI-MODEL</span></div>
<canvas id="forecastChart" style="max-height:300px;"></canvas></div></div>
<div class="pgrid">
<div class="panel"><div class="phead"><div class="ptitle">Model Comparison — MAE & RMSE</div></div><canvas id="errChart"></canvas></div>
<div class="panel"><div class="phead"><div class="ptitle">Seasonal Patterns</div><div class="psub">Weekly and monthly demand patterns</div></div><canvas id="seasonChart"></canvas></div>
</div></div><div class="sec" id="models">
<div class="pgrid">
<div class="panel"><div class="phead"><div class="ptitle">ARIMA vs Prophet vs LSTM</div></div>
<table><thead><tr><th>Model</th><th>MAE</th><th>RMSE</th><th>MAPE</th><th>Best For</th></tr></thead>
<tbody>
<tr><td>ARIMA(5,1,2)</td><td class="mono">98.4</td><td class="mono">124.2</td><td class="mono">14.6%</td><td style="font-size:11px;color:var(--muted)">Stationary series, short horizon</td></tr>
<tr><td>Prophet</td><td class="mono">62.1</td><td class="mono">81.4</td><td class="mono">7.8%</td><td style="font-size:11px;color:var(--muted)">Seasonality, holidays, trend changes</td></tr>
<tr><td>LSTM</td><td class="mono">74.8</td><td class="mono">96.1</td><td class="mono">11.2%</td><td style="font-size:11px;color:var(--muted)">Complex nonlinear patterns</td></tr>
</tbody></table></div>
<div class="panel"><div class="phead"><div class="ptitle">Why Prophet Wins</div></div>
<div style="display:flex;flex-direction:column;gap:8px;margin-top:4px;">
<div class="rbox"><div class="rbox-title">Seasonal decomposition</div><div class="rbox-sub">Prophet explicitly models yearly and weekly seasonality as Fourier series. Retail demand has strong seasonality that ARIMA struggles to capture without manual tuning.</div></div>
<div class="rbox"><div class="rbox-title">Holiday effects</div><div class="rbox-sub">Black Friday and Christmas spikes are modelled as custom regressors. LSTM and ARIMA treat these as noise without explicit event modelling.</div></div>
<div class="rbox"><div class="rbox-title">Changepoint detection</div><div class="rbox-sub">Prophet automatically detects trend changes in the training data. This is critical for retail demand which shifts with market conditions.</div></div>
</div></div></div></div><div class="sec" id="energy">
<div class="kgrid">
<div class="kcard grn"><span class="kval">520 kWh</span><span class="klbl">Peak Daily Consumption</span></div>
<div class="kcard nvy"><span class="kval">450 kWh</span><span class="klbl">Baseline (2021)</span></div>
<div class="kcard gld"><span class="kval">+15.6%</span><span class="klbl">Growth 2021-2024</span></div>
<div class="kcard tel"><span class="kval">Summer</span><span class="klbl">Peak Season</span></div>
</div>
<div class="panel pfull"><div class="phead"><div class="ptitle">Energy Consumption Forecast</div><div class="psub">Daily kWh · Seasonal patterns · Weekend vs weekday</div></div>
<canvas id="energyChart" style="max-height:280px;"></canvas></div></div></main>
<footer><div class="fin"><div class="fl"><strong>Sara Iqbal</strong> — MSc Data Science · London, UK<br>Demand Forecasting Engine · Python · Pandas · Prophet · PyTorch LSTM · statsmodels · ARIMA</div>
<div class="flinks"><a href='https://sara-iqbal.github.io/demand-forecasting-engine'>Live Dashboard</a><a href='https://colab.research.google.com'>Colab Notebook</a><a href='https://www.linkedin.com/in/saraiqbaldata0602/'>LinkedIn</a></div>
</div></footer>

<script>
Chart.defaults.font.family="'Outfit',sans-serif";Chart.defaults.font.size=11;Chart.defaults.color='#6b6459';
const G='rgba(226,221,214,0.6)';
const NAVY='#12234a',GOLD='#9a6b00',TEAL='#0c5f5a',GREEN='#145232',RED='#8b2020',AMBER='#7a4a0a';
function show(id,btn){document.querySelectorAll('.sec').forEach(s=>s.classList.remove('active'));document.querySelectorAll('.ntab').forEach(t=>t.classList.remove('active'));document.getElementById(id).classList.add('active');btn.classList.add('active');}
document.querySelectorAll('.kcard').forEach((c,i)=>c.style.animationDelay=i*.06+'s');
document.querySelectorAll('.panel').forEach((p,i)=>p.style.animationDelay=i*.07+'s');

const MONTHS=['Jul','Aug','Sep','Oct','Nov','Dec','Jan','Feb','Mar','Apr'];
const actual=Array.from({length:30},(_,i)=>900+80*Math.sin(i/4)+Math.random()*60-30);
const arima=actual.map(v=>v+(Math.random()-.5)*200);
const prophet=actual.map(v=>v+(Math.random()-.5)*100);
const lstm=actual.map(v=>v+(Math.random()-.5)*150);
const days=Array.from({length:30},(_,i)=>`Day ${i+1}`);
new Chart(document.getElementById('forecastChart'),{type:'line',data:{labels:days,datasets:[
{label:'Actual',data:actual,borderColor:'black',borderWidth:2,pointRadius:0,tension:.3},
{label:'ARIMA',data:arima,borderColor:TEAL,borderWidth:1.8,borderDash:[5,3],pointRadius:0,tension:.3},
{label:'Prophet',data:prophet,borderColor:GOLD,borderWidth:2,pointRadius:0,tension:.3},
{label:'LSTM',data:lstm,borderColor:NAVY,borderWidth:1.8,borderDash:[2,2],pointRadius:0,tension:.3},
]},options:{responsive:true,maintainAspectRatio:true,plugins:{legend:{labels:{usePointStyle:true}}},scales:{x:{ticks:{maxTicksLimit:10},grid:{color:G}},y:{grid:{color:G}}}}});
new Chart(document.getElementById('errChart'),{type:'bar',data:{labels:['ARIMA','Prophet','LSTM'],datasets:[
{label:'MAE',data:[98.4,62.1,74.8],backgroundColor:NAVY+'cc',borderRadius:3},
{label:'RMSE',data:[124.2,81.4,96.1],backgroundColor:GOLD+'cc',borderRadius:3}]},
options:{responsive:true,maintainAspectRatio:true,plugins:{legend:{labels:{usePointStyle:true}}},scales:{x:{grid:{color:G}},y:{grid:{color:G}}}}});
const weekdays=['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
const weekAvg=[820,840,860,890,980,1100,920];
new Chart(document.getElementById('seasonChart'),{type:'bar',data:{labels:weekdays,datasets:[{data:weekAvg,backgroundColor:NAVY+'cc',borderRadius:3}]},options:{responsive:true,maintainAspectRatio:true,plugins:{legend:{display:false}},scales:{x:{grid:{color:G}},y:{grid:{color:G}}}}});
const emonths=Array.from({length:90},(_,i)=>i);
const energy=emonths.map(i=>480+40*Math.cos(2*Math.PI*i/365*3)+20*Math.sin(2*Math.PI*i/7)+Math.random()*15);
new Chart(document.getElementById('energyChart'),{type:'line',data:{labels:emonths,datasets:[{label:'Energy kWh',data:energy,borderColor:GOLD,borderWidth:1.5,pointRadius:0,tension:.3,fill:true,backgroundColor:GOLD+'18'}]},options:{responsive:true,maintainAspectRatio:true,plugins:{legend:{display:false}},scales:{x:{ticks:{maxTicksLimit:10},grid:{color:G}},y:{grid:{color:G}}}}});
</script></body></html>
